{
  "name": "@gouvfr-lasuite/cunningham-react",
  "private": false,
  "version": "4.4.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./style": "./dist/style.css",
    "./fonts": "./dist/fonts.css",
    "./icons": "./dist/icons.css",
    "./sass/fonts": "./dist/sass/fonts.scss",
    "./sass/icons": "./dist/sass/icons.scss"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint": "eslint . \"src/**/*.{ts,tsx}\"",
    "dev": "yarn storybook",
    "build": "bash ./build",
    "build:watch": "yarn build && vite build --mode watch",
    "build:watch-polling": "yarn build && vite build --mode watch-polling",
    "build-fonts": "vite build -c vite.fonts.config.mts && rm -rf dist/fonts.js && make-dir dist/sass && cp src/fonts.scss dist/sass/",
    "build-icons": "vite build -c vite.icons.config.mts && rm -rf dist/icons.js && make-dir dist/sass && cp src/icons.scss dist/sass/",
    "build-theme": "cunningham -o src -g css,ts,js,scss",
    "preview": "vite preview",
    "test": "cross-env FORCE_COLOR=1 vitest run",
    "test-ci": "cross-env VITEST_MIN_THREADS=1 cross-env VITEST_MAX_THREADS=3 cross-env FORCE_COLOR=1 vitest run --shard ${SHARD_INDEX:-1}/${SHARD_TOTAL:-1}",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.1.2",
    "react-dom": "^19.1.2"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/material-icons-outlined": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@gouvfr-lasuite/cunningham-tokens": "*",
    "@react-aria/calendar": "3.10.1",
    "@react-aria/datepicker": "3.17.1",
    "@react-aria/i18n": "3.13.1",
    "@react-stately/calendar": "3.10.1",
    "@react-stately/datepicker": "3.17.1",
    "@tanstack/react-table": "9.2.4",
    "@types/react-modal": "3.16.3",
    "chromatic": "18.8.1",
    "classnames": "2.5.1",
    "downshift": "9.4.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-modal": "3.16.3",
    "react-stately": "3.50.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.27.1",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-proposal-export-default-from": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@chromatic-com/storybook": "5.3.1",
    "@faker-js/faker": "9.7.0",
    "@hookform/resolvers": "5.9.1",
    "@gouvfr-lasuite/cunningham-tokens": "*",
    "@gouvfr-lasuite/typescript-configs": "*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-actions": "9.0.8",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "10.6.0",
    "@storybook/preset-scss": "1.0.3",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/storybook-deployer": "2.8.16",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-c8": "0.33.0",
    "@vitest/ui": "5.0.0",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "glob": "13.0.6",
    "jsdom": "30.0.1",
    "react-hook-form": "7.88.0",
    "remark-gfm": "4.0.0",
    "sass": "1.104.1",
    "sass-loader": "17.0.1",
    "storybook": "8.6.12",
    "style-loader": "4.0.0",
    "typescript": "7.0.2",
    "vite": "6.4.1",
    "vite-plugin-dts": "5.1.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.1.2",
    "vitest-fetch-mock": "0.4.5",
    "yup": "1.7.1"
  },
  "volta": {
    "node": "20.16.0",
    "yarn": "1.22.22"
  }
}
